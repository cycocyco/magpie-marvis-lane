{
  "name": "magpie-marvis-lane",
  "version": "1.0.0",
  "type": "module",
  "description": "从 magpie-Jet-Hub 摘出的腾讯 Marvis 单车道 magpie 插件：内嵌 cordis 容器运行本体引擎，复用其账号池、静默续期、浏览器 OAuth 登录与设备指纹模拟；凭据落在插件自持目录，不依赖 DSH 安装；其余 28 家供应商与控制台已全部移除",
  "private": true,
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs --all",
    "gen:prices": "node scripts/gen-model-prices.mjs",
    "seed:auth": "node scripts/seed-auth.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "vendor",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "marvis",
    "tencent",
    "plugin",
    "auth",
    "provider",
    "deepseek"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycocyco/magpie-marvis-lane.git"
  },
  "upstream": {
    "name": "dsh-providers-hub",
    "repository": "https://github.com/iJetLi/dsh-providers-hub",
    "npm": "deepseek-harness-codearts",
    "version": "2.21.261109",
    "note": "vendor/ 是上游构建产物（commit 1d12f80e…）经本 fork 深度裁剪后的版本：只保留 marvis 车道与共享引擎，其余 28 家供应商的模块与接线已删除。与上游的对应关系详见 README。"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 8,
    "permissions": [
      "providers:list"
    ]
  }
}
